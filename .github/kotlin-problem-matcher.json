{
  "problemMatcher": [
    {
      "owner": "kotlinc-error",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^e: (?:file://)?(\\S+?\\.kts?):(\\d+):(\\d+) (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    }
  ]
}
