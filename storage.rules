rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /captions-audio/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    match /templates/{templateId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 200 * 1024 * 1024
        && (fileName == "preview.mp4" || fileName == "thumbnail.jpg");
    }

    // Downloadable JSON text-template catalogs, e.g. text/templates/catalog.json
    // (a JSON array in the same format as assets/text/templates/catalog.json).
    // Published by trusted tooling; the editor only reads them.
    match /text/templates/{file=**} {
      allow read: if true;
      allow write: if false;
    }

    match /text_templates/{file=**} {
      allow read: if true;
      allow write: if false;
    }

    match /text-templates/{file=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
