rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /templates/{templateId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 200 * 1024 * 1024
        && (fileName == "preview.mp4" || fileName == "thumbnail.jpg");
    }
  }
}
